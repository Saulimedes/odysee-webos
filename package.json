{
  "name": "org.webosbrew.odysee",
  "version": "1.1.0",
  "description": "Odysee Unofficial",
  "scripts": {
    "start": "webpack serve --config ./webpack.config.js --mode development",
    "build": "node tools/sync-version.js && webpack --config ./webpack.config.js --mode production && node tools/check-syntax.js",
    "package": "node tools/package.js",
    "deploy": "ares-install ${npm_package_name}_${npm_package_version}_all.ipk",
    "launch": "ares-launch ${npm_package_name}",
    "manifest": "node tools/gen-manifest.js ${npm_package_name}.manifest.json",
    "version": "node tools/sync-version.js && git add assets/appinfo.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint:fsd": "steiger src --fail-on-warnings",
    "lint:unused": "knip && knip --production",
    "test:chrome68": "node tests/browser/chrome68.cjs",
    "verify": "npm run typecheck && npm run lint:fsd && npm run lint:unused && npm run test:coverage && npm run build && npm run test:chrome68"
  },
  "keywords": [],
  "author": "informatic",
  "license": "GPL-3.0",
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@webosose/ares-cli": "^2.4.0",
    "acorn": "^8.17.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "puppeteer-core": "1.8.0",
    "steiger": "^0.7.0",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.7"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.49.0",
    "core-js": "^3.50.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
